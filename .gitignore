# ──────────────────────────────────────────────────────────────────────────
# .gitignore — covers all heavy / regenerable data.
# Versioned: code, docs, configs, scripts/libraries, exchange (AAF/XML/EDL),
#            .drp project backups, solved cameras.
# Ignored:   media (frames/video/geo/caches), renders, outputs, the CG library.
# NOTE: git does NOT support trailing inline comments — a `#` after a pattern
#       becomes part of the pattern and silently breaks the rule. Keep every
#       comment on its own line.
# ──────────────────────────────────────────────────────────────────────────

# ── IDE / tools ──
.vscode/
# .claude/  is tracked

# ── OS / temp ──
.DS_Store
Thumbs.db
*.swp
# editor / DCC backup & autosave files (e.g. comp_v001.nkind~, tracking.nkind.autosave)
*~
*.autosave
*.tmp
.tmp/
tmp/

# ── Python (venvs + tooling, e.g. PyOpenColorIO LUT bakes / pipeline scripts) ──
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ── Houdini ──
hou/backup/
hou/geo/
backup/
*.hip.bak
*.hiplc.bak
*.hipnc.bak
# vendored SideFX OCL libs (clones — not our IP, re-obtainable from Houdini)
hou/scripts/ocl/hou_lib/

# ── Heavy folders: caches / renders / outputs / finishing ──
**/cache/
**/caches/
**/render/
**/renders/
**/proxy/
**/optimized/
output/
exports/
deliver/
grade/cache/
_backup/

# ── Reusable CG library (heavy — kept on storage) ──
assets/

# ── Camera dailies / ingest (heavy — masters kept on external storage) ──
footage/

# ── Photogrammetry working metadata (RealityScan/Capture — regenerable, not interchange) ──
rsmeta.db
*.rsInfo

# ── DCC app working dirs (heavy) ──
blend/
comfy/
adobe/
davinci/
# Nuke comp renders/temp (comp scripts live in shots/<EP>/<SH>/comp)
nuke/comp/

# Nuke working files (disposable; canonical Blink code lives in nuke/scripts/blink)
*.nk
*.nknc
*.nkind
*.hrox
*.hroxind

# Nuke per-user / tools dirs (plugins, prefs, gizmos — not project IP)
.nuketools/
.nuke/

# Houdini scenes are production assets / working files — NOT tracked, EXCEPT the
# lightweight studio-tech demo(s) re-included below. lichens.hiplc = production element → ignored.
*.hip
*.hipnc
*.hiplc
!hou/biogrowth.hiplc

# ── Heavy media by extension (anywhere) ──
# frames / images
*.exr
*.hdr
*.dpx
*.cin
*.tif
*.tiff
*.tga
*.tx
*.rat
*.png
*.jpg
*.jpeg
*.bmp
*.psd
*.psb
*.j2k
*.jp2
# video
*.mov
*.mp4
*.m4v
*.mxf
*.avi
*.mkv
*.webm
*.mpg
*.mpeg
*.r3d
*.braw
*.ari
*.arx
*.dng
# geometry / volumes / caches
*.bgeo
*.bgeo.sc
*.bgeo.gz
*.geo
*.vdb
*.abc
*.usd
*.usdc
*.usda
*.usdz
*.fbx
*.obj
*.mtl
*.ply
*.stl
*.sim
*.bclip
*.pc
# audio
*.wav
*.aif
*.aiff
# archives / blobs
*.zip
*.rar
*.7z
*.blob

# ── Re-include small, important interchange ──
# solved cameras (small) stay versioned despite the geo-cache rules above
!shots/**/cam/*.abc
!shots/**/cam/*.usd
!shots/**/cam/*.fbx
