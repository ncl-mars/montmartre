// 4 out, 4 in
float4 hash44(float4 p4) {
    p4 = frac4(p4 * float4(0.1031f, 0.1030f, 0.0973f, 0.1099f));
    float d = dot(p4, float4(p4.w, p4.z, p4.x, p4.y) + 33.33f);
