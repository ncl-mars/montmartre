// BlinkScript 2D SDF shapes
// Converted from OpenCL sd_shapes_2d.cl
// https://iquilezles.org/articles/distfunctions2d/
// Depends on: utils.blib (frac, mod, dot22, ndot, fabs2, max2)

// Helper: fit01(x, omin, omax) = remap x from [0,1] to [omin,omax]
float fit01(float x, float omin, float omax) {
    return x * (omax - omin) + omin;
}

// Helper: 2D rotation
float2 rot2D(float2 p, float angle_deg) {
    float a = angle_deg * 3.1415926535897932f / 180.0f;
    float c = cos(a);
    float s = sin(a);
    return float2(c * p.x - s * p.y, s * p.x + c * p.y);
}

// Helper: 2x2 matrix * vector (row-major: [a b; c d] * [x y])
float2 mat2mul(float a, float b, float c, float d, float2 v) {
    return float2(a * v.x + b * v.y, c * v.x + d * v.y);
}

//--------------------------------------------------------------- Primitives

float sdLine(float2 pos, float scale, float2 a, float2 b) {
    a = a * scale;
    b = b * scale;
    float2 pa = pos - a;
    float2 ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0f, 1.0f);
    return length(pa - ba * h) - 0.001f;
}

float sdCircle(float2 pos, float r) {
    return length(pos) - r;
}

float sdCutCircle(float2 pos, float scale, float r, float h) {
    r *= scale;
    h *= scale;
    if (h <= -r) return sdCircle(pos, r);
    pos.x = fabs(pos.x);
    float w = sqrt(r * r - h * h);
    float s = max((h - r) * pos.x * pos.x + w * w * (h + r - 2.0f * pos.y), h * pos.x - w * pos.y);
    if (s < 0.0f) return length(pos) - r;
    if (pos.x < w) return h - pos.y;
    return length(pos - float2(w, h));
}

float sdPie(float2 pos, float r, float tb) {
    if (tb == 1.0f) return sdCircle(pos, r);
    pos = rot2D(pos, 90.0f);
    pos.x = fabs(pos.x);
    tb = clamp(tb, 0.0f, 1.0f);
    tb *= 3.1415926535897932f;
    float2 sc = float2(sin(tb), cos(tb));
    float l = length(pos) - r;
    float m = length(pos - sc * clamp(dot(pos, sc), 0.0f, r));
    return max(l, m * sign(sc.y * pos.x - sc.x * pos.y));
}

float sdArc(float2 pos, float scale, float ra, float th, float tb) {
    ra *= scale;
    th *= scale;
    ra -= th * 0.5f;
    pos = rot2D(pos, 90.0f);
    pos.x = fabs(pos.x);
    tb = clamp(tb, 0.0f, 1.0f);
    tb *= 3.1415926535897932f;
    float2 sc = float2(sin(tb), cos(tb));
    return ((sc.y * pos.x > sc.x * pos.y) ? length(pos - sc * ra) :
                                              fabs(length(pos) - ra)) - th * 0.5f;
}

float sdRing(float2 pos, float scale, float r, float th, float arc) {
    r *= scale;
    th *= scale;
    r -= th * 0.5f;
    pos = rot2D(pos, 90.0f);
    pos.x = fabs(pos.x);
    arc = clamp(arc, 0.0f, 1.0f);
    arc *= 3.1415926535897932f;
    float2 sc = float2(cos(arc), sin(arc));
    // mat2 rotation: [sc.x sc.y; -sc.y sc.x]
    pos = mat2mul(sc.x, sc.y, -sc.y, sc.x, pos);
    return max(fabs(length(pos) - r) - th * 0.5f,
               length(float2(pos.x, max(0.0f, fabs(r - pos.y) - th * 0.5f))) * sign(pos.x));
}

float sdRectangle(float2 pos, float scale, float2 size) {
    size = size * scale * 0.5f;
    float2 d = fabs2(pos) - size;
    return length(max2(d, 0.0f)) + min(max(d.x, d.y), 0.0f);
}

float sdRoundedRectangle(float2 pos, float scale, float2 size, float4 r) {
    size = size * scale * 0.5f;
    r = r * scale;
    r.x = (pos.x > 0.0f) ? r.x : r.z;
    r.y = (pos.x > 0.0f) ? r.y : r.w;
    r.x = (pos.y > 0.0f) ? r.x : r.y;
    float2 d = fabs2(pos) - size + r.x;
    return length(max2(d, 0.0f)) + min(max(d.x, d.y), 0.0f) - r.x;
}

float sdDiamond(float2 pos, float scale, float2 b) {
    b = b * scale;
    pos = fabs2(pos);
    float h = clamp(ndot(b - 2.0f * pos, b) / dot(b, b), -1.0f, 1.0f);
    float2 r = 0.5f * b * float2(1.0f - h, 1.0f + h);
    float d = length(pos - r);
    return d * sign(pos.x * b.y + pos.y * b.x - b.x * b.y);
}

float sdTrapezoid(float2 pos, float scale, float he, float r1, float r2) {
    he *= scale * 0.5f;
    r1 *= scale * 0.5f;
    r2 *= scale * 0.5f;
    pos.x = fabs(pos.x);
    float2 k1 = float2(r2, he);
    float2 k2 = float2(r2 - r1, 2.0f * he);
    float2 ca = float2(pos.x - min(pos.x, (pos.y < 0.0f) ? r1 : r2), fabs(pos.y) - he);
    float2 cb = pos - k1 + k2 * clamp(dot(k1 - pos, k2) / dot22(k2), 0.0f, 1.0f);
    float s = (cb.x < 0.0f && ca.y < 0.0f) ? -1.0f : 1.0f;
    return s * sqrt(min(dot22(ca), dot22(cb)));
}

float sdParallelogram(float2 pos, float scale, float wi, float he, float sk) {
    wi *= scale;
    he *= scale;
    sk *= scale;
    pos = (pos.y < 0.0f) ? -pos : pos;
    float2 e = float2(sk, he);
    float2 w = pos - e;
    w.x -= clamp(w.x, -wi, wi);
    float2 d = float2(dot(w, w), -w.y);
    float s = pos.x * e.y - pos.y * e.x;
    pos = (s < 0.0f) ? -pos : pos;
    float2 v = pos - float2(wi, 0.0f);
    v = v - e * clamp(dot(v, e) / dot(e, e), -1.0f, 1.0f);
    d = min(d, float2(dot(v, v), wi * he - fabs(s)));
    return sqrt(d.x) * sign(-d.y);
}

float sdTriangle(float2 pos, float scale, float2 p0, float2 p1, float2 p2) {
    if (scale == 0.0f) return sdCircle(pos, 0.0f);
    p0 = p0 * scale;
    p1 = p1 * scale;
    p2 = p2 * scale;
    float2 e0 = p1 - p0;
    float2 e1 = p2 - p1;
    float2 e2 = p0 - p2;
    float2 v0 = pos - p0;
    float2 v1 = pos - p1;
    float2 v2 = pos - p2;
    float2 pq0 = v0 - e0 * clamp(dot(v0, e0) / dot(e0, e0), 0.0f, 1.0f);
    float2 pq1 = v1 - e1 * clamp(dot(v1, e1) / dot(e1, e1), 0.0f, 1.0f);
    float2 pq2 = v2 - e2 * clamp(dot(v2, e2) / dot(e2, e2), 0.0f, 1.0f);
    float s = sign(e0.x * e2.y - e0.y * e2.x);
    float2 d = min(min(float2(dot(pq0, pq0), s * (v0.x * e0.y - v0.y * e0.x)),
                       float2(dot(pq1, pq1), s * (v1.x * e1.y - v1.y * e1.x))),
                       float2(dot(pq2, pq2), s * (v2.x * e2.y - v2.y * e2.x)));
    return -sqrt(d.x) * sign(d.y);
}

float sdEquilateralTriangle(float2 pos, float r) {
    float k = sqrt(3.0f);
    pos.x = fabs(pos.x) - r;
    pos.y = pos.y + r / k;
    if (pos.x + k * pos.y > 0.0f) {
        pos = float2(pos.x - k * pos.y, -k * pos.x - pos.y) / 2.0f;
    }
    pos.x -= clamp(pos.x, -2.0f * r, 0.0f);
    return -length(pos) * sign(pos.y);
}

float sdTriangleIsosceles(float2 pos, float scale, float qw, float qh) {
    qw *= scale;
    qh *= scale;
    if (qh == 0.0f) return sdLine(pos, scale, float2(-qw, 0.0f), float2(qw, 0.0f));
    float2 _q = float2(qw, qh);
    pos = rot2D(pos, 180.0f);
    pos.y += _q.y * 0.5f;
    pos.x = fabs(pos.x);
    float2 a = pos - _q * clamp(dot(pos, _q) / dot(_q, _q), 0.0f, 1.0f);
    float2 b = pos - _q * float2(clamp(pos.x / _q.x, 0.0f, 1.0f), 1.0f);
    float s = -sign(_q.y);
    float2 d = min(float2(dot(a, a), s * (pos.x * _q.y - pos.y * _q.x)),
                   float2(dot(b, b), s * (pos.y - _q.y)));
    return -sqrt(d.x) * sign(d.y);
}

float sdCapsule(float2 pos, float scale, float h, float r1, float r2) {
    h *= scale;
    r1 *= scale;
    r2 *= scale;
    if (h == 0.0f) return sdCircle(pos, min(r1, r2));
    pos.x = fabs(pos.x);
    pos.y += h * 0.5f;
    float b = (r1 - r2) / h;
    float a = sqrt(1.0f - b * b);
    float k = dot(pos, float2(-b, a));
    if (k < 0.0f) return length(pos) - r1;
    if (k > a * h) return length(pos - float2(0.0f, h)) - r2;
    return dot(pos, float2(a, b)) - r1;
}

float sdDogBone(float2 pos, float scale, float w, float r, float b) {
    if (fabs(b) < 1e-5f) {
        pos = rot2D(pos, 90.0f);
        return sdCapsule(pos, scale, w, r, r);
    }
    w *= scale;
    r *= scale;
    b = -b;
    w *= 0.5f;
    pos = fabs2(pos);
    float y = (w * w - r * r) / (2.0f * r * b);
    float h = length(float2(w, y));
    float dE = length(pos - float2(w, 0.0f));
    float dC = length(pos - float2(0.0f, y)) - h;
    float sb = sign(b);
    return (sb * (w * pos.y + y * (pos.x - w)) > 0.0f ? dE : -sb * dC) - r;
}

float sdEllipse(float2 pos, float scale, float2 ab) {
    ab = ab * scale;
    if (ab.x == ab.y) return length(pos) - ab.x;
    pos = fabs2(pos);
    if (pos.x > pos.y) {
        pos = float2(pos.y, pos.x);
        ab = float2(ab.y, ab.x);
    }
    float l = ab.y * ab.y - ab.x * ab.x;
    float m = ab.x * pos.x / l;
    float n = ab.y * pos.y / l;
    float m2 = m * m;
    float n2 = n * n;
    float c = (m2 + n2 - 1.0f) / 3.0f;
    float c3 = c * c * c;
    float q = c3 + m2 * n2 * 2.0f;
    float d = c3 + m2 * n2;
    float g = m + m * n2;
    float co;
    if (d < 0.0f) {
        float h = acos(q / c3) / 3.0f;
        float s = cos(h);
        float t = sin(h) * sqrt(3.0f);
        float rx = sqrt(-c * (s + t + 2.0f) + m2);
        float ry = sqrt(-c * (s - t + 2.0f) + m2);
        co = ry + sign(l) * rx + fabs(g) / (rx * ry);
    } else {
        float h = 2.0f * m * n * sqrt(d);
        float s = sign(q + h) * pow(fabs(q + h), 1.0f / 3.0f);
        float u = sign(q - h) * pow(fabs(q - h), 1.0f / 3.0f);
        float rx = -s - u - c * 4.0f + 2.0f * m2;
        float ry = (s - u) * sqrt(3.0f);
        float rm = sqrt(rx * rx + ry * ry);
        co = ry / sqrt(rm - rx) + 2.0f * g / rm;
    }
    co = (co - m) / 2.0f;
    float si = sqrt(max(1.0f - co * co, 0.0f));
    float2 r = ab * float2(co, si);
    return length(r - pos) * sign(pos.y - r.y);
}

float sdQuadraticCircle(float2 pos, float r) {
    if (r == 0.0f) return sdCircle(pos, r);
    pos = pos / r;
    pos = fabs2(pos);
    if (pos.y > pos.x) pos = float2(pos.y, pos.x);
    float a = pos.x - pos.y;
    float b = pos.x + pos.y;
    float c = (2.0f * b - 1.0f) / 3.0f;
    float h = a * a + c * c * c;
    float t = 0.0f;
    if (h >= 0.0f) {
        h = sqrt(h);
        t = sign(h - a) * pow(fabs(h - a), 1.0f / 3.0f) - pow(h + a, 1.0f / 3.0f);
    } else {
        float z = sqrt(-c);
        float v = acos(a / (c * z)) / 3.0f;
        t = -z * (cos(v) + sin(v) * 1.732050808f);
    }
    t *= 0.5f;
    float k = 0.75f - t * t;
    float2 w = float2(-t + k, t + k) - pos;
    return length(w * r) * sign(a * a * 0.5f + b - 1.5f);
}

float sdArchway(float2 pos, float scale, float2 wh) {
    wh = wh * scale;
    pos.x = fabs(pos.x);
    pos.y = -pos.y;
    float2 q = pos - wh;
    float d1 = dot22(float2(max(q.x, 0.0f), q.y));
    q.x = (pos.y > 0.0f) ? q.x : length(pos) - wh.x;
    float d2 = dot22(float2(q.x, max(q.y, 0.0f)));
    float d = sqrt(min(d1, d2));
    return (max(q.x, q.y) < 0.0f) ? -d : d;
}

float sdPentagon(float2 pos, float r) {
    float3 k = float3(0.809016994f, 0.587785252f, 0.726542528f);
    pos.x = fabs(pos.x);
    float d1 = dot(float2(-k.x, k.y), pos);
    pos = pos - 2.0f * min(d1, 0.0f) * float2(-k.x, k.y);
    float d2 = dot(float2(k.x, k.y), pos);
    pos = pos - 2.0f * min(d2, 0.0f) * float2(k.x, k.y);
    pos = pos - float2(clamp(pos.x, -r * k.z, r * k.z), r);
    return length(pos) * sign(pos.y);
}

float sdHexagon(float2 pos, float r) {
    float3 k = float3(-0.866025404f, 0.5f, 0.577350269f);
    pos = fabs2(pos);
    float d1 = dot(float2(k.x, k.y), pos);
    pos = pos - 2.0f * min(d1, 0.0f) * float2(k.x, k.y);
    pos = pos - float2(clamp(pos.x, -k.z * r, k.z * r), r);
    return length(pos) * sign(pos.y);
}

float sdOctogon(float2 pos, float r) {
    float3 k = float3(-0.9238795325f, 0.3826834323f, 0.4142135623f);
    pos = fabs2(pos);
    float d1 = dot(float2(k.x, k.y), pos);
    pos = pos - 2.0f * min(d1, 0.0f) * float2(k.x, k.y);
    float d2 = dot(float2(-k.x, k.y), pos);
    pos = pos - 2.0f * min(d2, 0.0f) * float2(-k.x, k.y);
    pos = pos - float2(clamp(pos.x, -k.z * r, k.z * r), r);
    return length(pos) * sign(pos.y);
}

float sdHexagram(float2 pos, float r) {
    float4 k = float4(-0.5f, 0.8660254038f, 0.5773502692f, 1.7320508076f);
    pos = fabs2(pos);
    float d1 = dot(float2(k.x, k.y), pos);
    pos = pos - 2.0f * min(d1, 0.0f) * float2(k.x, k.y);
    float d2 = dot(float2(k.y, k.x), pos);
    pos = pos - 2.0f * min(d2, 0.0f) * float2(k.y, k.x);
    pos = pos - float2(clamp(pos.x, r * k.z, r * k.w), r);
    return length(pos) * sign(pos.y);
}

float sdStar(float2 pos, float r, int n, float m) {
    float an = 3.1415926535897932f / float(n);
    float en = 3.1415926535897932f / m;
    float2 acs = float2(cos(an), sin(an));
    float2 ecs = float2(cos(en), sin(en));
    float bn = mod(atan2(pos.x, pos.y), 2.0f * an) - an;
    pos = length(pos) * float2(cos(bn), fabs(sin(bn)));
    pos = pos - r * acs;
    pos = pos + ecs * clamp(-dot(pos, ecs), 0.0f, r * acs.y / ecs.y);
    return length(pos) * sign(pos.x);
}

float sdVesicaSegment(float2 pos, float2 a, float2 b, float w) {
    float r = 0.5f * length(b - a);
    float d = 0.5f * (r * r - w * w) / w;
    float2 v = (b - a) / r;
    float2 c = (b + a) * 0.5f;
    // mat2 [v.y v.x; -v.x v.y] * (pos - c)
    float2 q = fabs(mat2mul(v.y, v.x, -v.x, v.y, pos - c));
    q = q * 0.5f;
    float3 h = (r * q.x < d * (q.y - r)) ? float3(0.0f, r, 0.0f) : float3(-d, 0.0f, d + w);
    return length(q - float2(h.x, h.y)) - h.z;
}

float sdVesica(float2 pos, float scale, float r, float w) {
    r *= scale;
    w *= scale;
    float2 a = float2(0.0f, r);
    float2 b = float2(0.0f, -r);
    if (w == 0.0f) return sdLine(pos, scale, a, b);
    w = min(w, r);
    return sdVesicaSegment(pos, a, b, w);
}

float sdMoon(float2 pos, float scale, float ra, float rb, float d) {
    ra *= scale;
    rb *= scale;
    float end = ra + rb;
    d = fit01(d, -end, end);
    pos.y = fabs(pos.y);
    float a = (ra * ra - rb * rb + d * d) / (2.0f * d);
    float b = sqrt(max(ra * ra - a * a, 0.0f));
    if (d * (pos.x * b - pos.y * a) > d * d * max(b - pos.y, 0.0f))
        return length(pos - float2(a, b));
    return max(length(pos) - ra, -(length(pos - float2(d, 0.0f)) - rb));
}

float sdEgg(float2 pos, float scale, float ra, float rb) {
    ra *= scale;
    rb *= scale;
    rb = min(rb, ra);
    pos.x = fabs(pos.x);
    float k = sqrt(3.0f);
    float r = ra - rb;
    if (pos.y < 0.0f) return length(pos) - r - rb;
    if (k * (pos.x + r) < pos.y) return length(float2(pos.x, pos.y - k * r)) - rb;
    return length(float2(pos.x + r, pos.y)) - 2.0f * r - rb;
}

float sdHorseshoe(float2 pos, float scale, float r, float tb, float2 w) {
    r *= scale;
    w = w * scale;
    pos.x = fabs(pos.x);
    float l = length(pos);
    tb = clamp(tb, 0.0f, 1.0f);
    tb *= 3.1415926535897932f;
    float2 sc = float2(cos(tb), sin(tb));
    // mat2 [-sc.x sc.y; sc.y sc.x]
    pos = mat2mul(-sc.x, sc.y, sc.y, sc.x, pos);
    pos = float2((pos.y > 0.0f || pos.x > 0.0f) ? pos.x : l * sign(-sc.x),
                 (pos.x > 0.0f) ? pos.y : l);
    pos = float2(pos.x, fabs(pos.y - r)) - w;
    return length(max2(pos, 0.0f)) + min(0.0f, max(pos.x, pos.y));
}

float sdCross(float2 pos, float scale, float2 b, float r) {
    b.x *= scale;
    r *= scale;
    b.y = fit01(b.y, b.x, 0.0f);
    pos = fabs2(pos);
    pos = (pos.y > pos.x) ? float2(pos.y, pos.x) : pos;
    float2 q = pos - b;
    float k = max(q.y, q.x);
    float2 w = (k > 0.0f) ? q : float2(b.y - pos.x, -k);
    return sign(k) * length(max2(w, 0.0f)) + r;
}

float sdRoundedX(float2 pos, float scale, float w, float r) {
    r *= scale;
    w *= scale;
    pos = fabs2(pos);
    return length(pos - min(pos.x + pos.y, w) * 0.5f) - r;
}

float sdCircleWave(float2 pos, float scale, float tb, float ra) {
    ra *= scale;
    pos.x = fabs(pos.x);
    tb = 3.1415926535897932f * 5.0f / 6.0f * max(tb, 0.0001f);
    float2 co = ra * float2(sin(tb), cos(tb));
    pos.x = fabs(mod(pos.x, co.x * 4.0f) - co.x * 2.0f);
    float2 p1 = pos;
    float2 p2 = float2(fabs(pos.x - 2.0f * co.x), -pos.y + 2.0f * co.y);
    float d1 = (co.y * p1.x > co.x * p1.y) ? length(p1 - co) : fabs(length(p1) - ra);
    float d2 = (co.y * p2.x > co.x * p2.y) ? length(p2 - co) : fabs(length(p2) - ra);
    return min(d1, d2);
}

float sdSpiral(float2 pos, float scale, float w, float h, int n) {
    w *= scale;
    pos.x += w;
    float d = length(pos);
    for (int i = 0; i < n; i++) {
        pos.x -= w;
        if (pos.x < 0.0f && pos.y > 0.0f) d = min(d, fabs(length(pos) - w));
        pos.y -= w;
        pos = float2(-pos.y, pos.x);
        w *= h;
    }
    return min(d, length(pos));
}

float sdHeart(float2 pos) {
    pos.x = fabs(pos.x);
    if (pos.y + pos.x > 1.0f)
        return sqrt(dot22(pos - float2(0.25f, 0.75f))) - sqrt(2.0f) / 4.0f;
    return sqrt(min(dot22(pos - float2(0.0f, 1.0f)),
                    dot22(pos - 0.5f * max(pos.x + pos.y, 0.0f)))) * sign(pos.x - pos.y);
}

