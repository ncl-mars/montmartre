//--------------------------------------------------------------- Markers

float sdMarkerT(float2 pos, float size) {
    size *= 2.0f;
    float x = -pos.y;
    float y = pos.x;
    float r1 = max(fabs(x - size / 3.0f + size / 3.0f), fabs(x - size / 3.0f - size / 3.0f));
    float r2 = max(fabs(y - size / 3.0f), fabs(y + size / 3.0f));
    float r3 = max(fabs(x), fabs(y));
    float r = max(min(r1, r2), r3);
    return r - size / 2.0f;
}

float sdMarkerCheck(float2 pos, float size) {
    size *= 2.0f;
    pos.x *= -1.0f;
    pos = rot2D(pos, -90.0f);
    float x = 1.4142135623730951f / 2.0f * (pos.x - pos.y);
    float y = 1.4142135623730951f / 2.0f * (pos.x + pos.y);
    float r1 = max(fabs(x - 2.0f * size / 3.0f), fabs(x - size / 3.0f));
    float r2 = max(fabs(y - 2.0f * size / 3.0f), fabs(y - size / 3.0f));
    float r3 = max(fabs(x), max(fabs(x - size / 3.0f), fabs(y)));
    float r = max(min(r1, r2), r3);
    return r - size / 2.0f;
}

float sdMarkerCross(float2 pos, float size) {
    size *= 2.0f;
    float x = 1.4142135623730951f / 2.0f * (pos.x - pos.y);
    float y = 1.4142135623730951f / 2.0f * (pos.x + pos.y);
    float r1 = max(fabs(x - size / 3.0f), fabs(x + size / 3.0f));
    float r2 = max(fabs(y - size / 3.0f), fabs(y + size / 3.0f));
    float r3 = max(fabs(x), fabs(y));
    float r = max(min(r1, r2), r3);
    return r - size / 2.0f;
}

float sdMarkerClobber(float2 pos, float size) {
    size *= 2.0f;
    float t1 = -3.1415926535897932f / 2.0f;
    float2 c1 = 0.25f * float2(cos(t1), sin(t1));
    float t2 = t1 + 2.0f * 3.1415926535897932f / 3.0f;
    float2 c2 = 0.25f * float2(cos(t2), sin(t2));
    float t3 = t2 + 2.0f * 3.1415926535897932f / 3.0f;
    float2 c3 = 0.25f * float2(cos(t3), sin(t3));
    float r1 = length(pos - c1 * size) - size / 3.5f;
    float r2 = length(pos - c2 * size) - size / 3.5f;
    float r3 = length(pos - c3 * size) - size / 3.5f;
    return min(min(r1, r2), r3);
}

float sdMarkerAsterisk(float2 pos, float size) {
    size *= 2.0f;
    float x = 1.4142135623730951f / 2.0f * (pos.x - pos.y);
    float y = 1.4142135623730951f / 2.0f * (pos.x + pos.y);
    float r1 = max(fabs(x) - size / 2.0f, fabs(y) - size / 10.0f);
    float r2 = max(fabs(y) - size / 2.0f, fabs(x) - size / 10.0f);
    float r3 = max(fabs(pos.x) - size / 2.0f, fabs(pos.y) - size / 10.0f);
    float r4 = max(fabs(pos.y) - size / 2.0f, fabs(pos.x) - size / 10.0f);
    return min(min(r1, r2), min(r3, r4));
}

float sdMarkerChevron(float2 pos, float size) {
    size *= 2.0f;
    pos = rot2D(pos, 180.0f);
    float x = 1.0f / 1.4142135623730951f * (pos.x - pos.y);
    float y = 1.0f / 1.4142135623730951f * (pos.x + pos.y);
    float r1 = max(fabs(x), fabs(y)) - size / 3.0f;
    float r2 = max(fabs(x - size / 3.0f), fabs(y - size / 3.0f)) - size / 3.0f;
    return max(r1, -r2);
}

float sdMarkerRing(float2 pos, float size) {
    size *= 2.0f;
    float r1 = length(pos) - size / 2.0f;
    float r2 = length(pos) - size / 4.0f;
    return max(r1, -r2);
}

float sdMarkerInfinity(float2 pos, float size) {
    size *= 2.0f;
    float2 c1 = float2(0.25f, 0.0f);
    float2 c2 = float2(-0.25f, 0.0f);
    float r1 = length(pos - c1 * size) - size / 3.0f;
    float r2 = length(pos - c1 * size) - size / 7.0f;
    float r3 = length(pos - c2 * size) - size / 3.0f;
    float r4 = length(pos - c2 * size) - size / 7.0f;
    return min(max(r1, -r2), max(r3, -r4));
}

float sdMarkerTag(float2 pos, float size) {
    size *= 2.0f;
    pos = rot2D(pos, -135.0f);
    float x = -pos.x;
    float y = pos.y;
    float r1 = max(fabs(x) - size / 2.0f, fabs(y) - size / 6.0f);
    float r2 = fabs(x - size / 1.5f) + fabs(y) - size;
    return max(r1, 0.75f * r2);
}

// //--------------------------------------------------------------- Bezier

float testCross2D(float2 a, float2 b, float2 p) {
    return sign((b.y - a.y) * (p.x - a.x) - (b.x - a.x) * (p.y - a.y));
}

float signBezier(float2 A, float2 B, float2 C, float2 pos) {
    float2 a = C - A;
    float2 b = B - A;
    float2 c = pos - A;
    float2 bary = float2(c.x * b.y - b.x * c.y, a.x * c.y - c.x * a.y) / (a.x * b.y - b.x * a.y);
    float2 d = float2(bary.y * 0.5f, 0.0f) + 1.0f - bary.x - bary.y;
    float s1 = (d.x - d.y < 0.0f) ?
        lerp(-1.0f, 1.0f, (testCross2D(A, B, pos) * testCross2D(B, C, pos) <= 0.0f) ? 1.0f : 0.0f) :
        sign(d.x * d.x - d.y);
    return s1 * testCross2D(A, C, B);
}

float3 solveCubic(float a, float b, float c) {
    float p = b - a * a / 3.0f;
    float p3 = p * p * p;
    float q = a * (2.0f * a * a - 9.0f * b) / 27.0f + c;
    float d = q * q + 4.0f * p3 / 27.0f;
    float offset = -a / 3.0f;
    if (d >= 0.0f) {
        float z = sqrt(d);
        float2 x = float2(z - q, -z - q) / 2.0f;
        float2 uv = float2(sign(x.x) * pow(fabs(x.x), 1.0f / 3.0f),
                           sign(x.y) * pow(fabs(x.y), 1.0f / 3.0f));
        return float3(offset + uv.x + uv.y, offset + uv.x + uv.y, offset + uv.x + uv.y);
    }
    float v = acos(-sqrt(-27.0f / p3) * q / 2.0f) / 3.0f;
    float m = cos(v);
    float n = sin(v) * 1.732050808f;
    return float3(m + m, -n - m, n - m) * sqrt(-p / 3.0f) + offset;
}

float sdBezier(float2 pos, float scale, float2 A, float2 B, float2 C) {
    A = A * scale;
    B = B * scale;
    C = C * scale;
    B = lerp(B + 1e-4f, B, fabs(sign(B * 2.0f - A - C)));
    float2 a = B - A;
    float2 b = A - B * 2.0f + C;
    float2 c = a * 2.0f;
    float2 d = A - pos;
    float3 k = float3(3.0f * dot(a, b), 2.0f * dot(a, a) + dot(d, b), dot(d, a)) / dot(b, b);
    float3 t = clamp(solveCubic(k.x, k.y, k.z), 0.0f, 1.0f);
    float2 _pos = A + (c + b * t.x) * t.x;
    float dist = length(_pos - pos);
    _pos = A + (c + b * t.y) * t.y;
    dist = min(dist, length(_pos - pos));
    _pos = A + (c + b * t.z) * t.z;
    dist = min(dist, length(_pos - pos));
    return dist * signBezier(A, B, C, pos);
}

float sdBlobbyCross(float2 pos, float he) {
    pos = fabs2(pos) * 2.0f;
    pos = float2(fabs(pos.x - pos.y), 1.0f - pos.x - pos.y) / 1.4142135623730951f;
    float p = (he - pos.y - 0.25f / he) / (6.0f * he);
    float q = pos.x / (he * he * 16.0f);
    float h = q * q - p * p * p;
    float x = 0.0f;
    if (h > 0.0f) {
        float r = sqrt(h);
        x = pow(q + r, 1.0f / 3.0f) - pow(fabs(q - r), 1.0f / 3.0f) * sign(r - q);
    } else {
        float r = sqrt(p);
        x = 2.0f * r * cos(acos(q / (p * r)) / 3.0f);
    }
    x = min(x, 1.4142135623730951f / 2.0f);
    float2 z = float2(x, he * (1.0f - 2.0f * x * x)) - pos;
    return length(z * 0.6f) * sign(z.y);
}

float sdWaveSpiral(float2 pos, float scale, float w, float k) {
    w *= scale;
    k *= scale;
    float kTau = 6.283185307f;
    float r = length(pos);
    float a = atan2(pos.y, pos.x);
    float n = floor(0.5f / w + ((log(r / w) / log(2.0f)) * k - a) / kTau);
    float ra = w * pow(2.0f, (a + kTau * (min(n + 0.0f, 0.0f) - 0.5f)) / k);
    float rb = w * pow(2.0f, (a + kTau * (min(n + 1.0f, 0.0f) - 0.5f)) / k);
    float d = min(fabs(r - ra), fabs(r - rb));
    return min(d, length(pos + float2(w, 0.0f)));
}
