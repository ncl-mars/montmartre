// BlinkScript 3D SDF shapes
// Converted from OpenCL sd_shapes_3d.cl
// https://iquilezles.org/articles/distfunctions/
// Depends on: utils.blib (dot2, ndot, fabs2, fabs3, max2, max3)

// Sphere - exact
float sdSphere(float3 p, float r) {
    return length(p) - r;
}

// Box - exact
float sdBox(float3 p, float3 b) {
    float3 q = fabs3(p) - b;
    return length(max3(q, 0.0f)) + min(max(q.x, max(q.y, q.z)), 0.0f);
}

// Box with normals
float4 sdNorBox(float3 p, float3 b) {
    float3 d = fabs3(p) - b;
    float x = min(max(d.x, max(d.y, d.z)), 0.0f) + length(max3(d, 0.0f));
    // step(d.yzx, d.xyz) * step(d.zxy, d.xyz) * sign(p)
    float3 syz = float3(
        (d.y <= d.x ? 1.0f : 0.0f) * (d.z <= d.x ? 1.0f : 0.0f) * sign(p.x),
        (d.z <= d.y ? 1.0f : 0.0f) * (d.x <= d.y ? 1.0f : 0.0f) * sign(p.y),
        (d.x <= d.z ? 1.0f : 0.0f) * (d.y <= d.z ? 1.0f : 0.0f) * sign(p.z)
    );
    return float4(x, syz.x, syz.y, syz.z);
}

// Round Box - exact
float sdRoundBox(float3 p, float3 b, float r) {
    float3 q = fabs3(p) - b + r;
    return length(max3(q, 0.0f)) + min(max(q.x, max(q.y, q.z)), 0.0f) - r;
}

// Bounding Box - exact
float sdBoundingBox(float3 p, float3 b, float e) {
    p = fabs3(p) - b;
    float3 q = fabs3(p + e) - e;
    return min(min(
        length(max3(float3(p.x, q.y, q.z), 0.0f)) + min(max(p.x, max(q.y, q.z)), 0.0f),
        length(max3(float3(q.x, p.y, q.z), 0.0f)) + min(max(q.x, max(p.y, q.z)), 0.0f)),
        length(max3(float3(q.x, q.y, p.z), 0.0f)) + min(max(q.x, max(q.y, p.z)), 0.0f));
}

// Plane - exact (n must be normalized)
float sdPlane(float3 p, float3 n, float h) {
    return dot(p, n) + h;
}

// Torus - exact
float sdTorus(float3 p, float2 t) {
    float2 q = float2(length(float2(p.x, p.z)) - t.x, p.y);
    return length(q) - t.y;
}

// Capped Torus - exact
float sdCappedTorus(float3 p, float2 sc, float ra, float rb) {
    p.x = fabs(p.x);
    float k = (sc.y * p.x > sc.x * p.y) ? dot(float2(p.x, p.y), sc) : length(float2(p.x, p.y));
    return sqrt(dot(p, p) + ra * ra - 2.0f * ra * k) - rb;
}

// Link - exact
float sdLinkX(float3 p, float le, float r1, float r2) {
    float3 q = float3(p.x, max(fabs(p.y) - le, 0.0f), p.z);
    return length(float2(length(float2(q.x, q.y)) - r1, q.z)) - r2;
}

// Infinite Cylinder - exact
float sdCylinderInf(float3 p, float3 c) {
    return length(float2(p.x, p.z) - float2(c.x, c.y)) - c.z;
}

// Cone - exact
float sdCone(float3 p, float2 c, float h) {
    // c is the sin/cos of the angle, h is height
    float2 q = h * float2(c.x / c.y, -1.0f);
    float2 w = float2(length(float2(p.x, p.z)), p.y);
    float2 a = w - q * clamp(dot(w, q) / dot(q, q), 0.0f, 1.0f);
    float2 b = w - q * float2(clamp(w.x / q.x, 0.0f, 1.0f), 1.0f);
    float k = sign(q.y);
    float d = min(dot(a, a), dot(b, b));
    float s = max(k * (w.x * q.y - w.y * q.x), k * (w.y - q.y));
    return sqrt(d) * sign(s);
}

// Cone - bound (not exact!)
float sdConeB(float3 p, float2 c, float h) {
    float q = length(float2(p.x, p.z));
    return max(dot(float2(c.x, c.y), float2(q, p.y)), -h - p.y);
}

// Infinite Cone - exact
float sdConeInf(float3 p, float2 c) {
    // c is the sin/cos of the angle
    float2 q = float2(length(float2(p.x, p.z)), -p.y);
    float d = length(q - c * max(dot(q, c), 0.0f));
    return d * ((q.x * c.y - q.y * c.x < 0.0f) ? -1.0f : 1.0f);
}

// Hexagonal Prism - exact
float sdHexPrism(float3 p, float2 h) {
    float3 k = float3(-0.8660254f, 0.5f, 0.57735f);
    p = fabs3(p);
    // p.xy -= 2.0 * min(dot(k.xy, p.xy), 0.0) * k.xy
    float dkp = dot(float2(k.x, k.y), float2(p.x, p.y));
    p.x -= 2.0f * min(dkp, 0.0f) * k.x;
    p.y -= 2.0f * min(dkp, 0.0f) * k.y;
    float2 d = float2(
        length(float2(p.x, p.y) - float2(clamp(p.x, -k.z * h.x, k.z * h.x), h.x)) * sign(p.y - h.x),
        p.z - h.y);
    return min(max(d.x, d.y), 0.0f) + length(max2(d, 0.0f));
}

// Triangular Prism - bound
float sdTriPrism(float3 p, float2 h) {
    float3 q = fabs3(p);
    return max(q.z - h.y, max(q.x * 0.866025f + p.y * 0.5f, -p.y) - h.x * 0.5f);
}

// Capsule / Line - exact
float sdCapsule3D(float3 p, float3 a, float3 b, float r) {
    float3 pa = p - a;
    float3 ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0f, 1.0f);
    return length(pa - ba * h) - r;
}

// Vertical Capsule - exact
float sdVerticalCapsule(float3 p, float h, float r) {
    p.y -= clamp(p.y, 0.0f, h);
    return length(p) - r;
}

// Capped Cylinder - exact
float sdCappedCylinder(float3 p, float h, float r) {
    float2 d = fabs2(float2(length(float2(p.x, p.z)), p.y)) - float2(h, r);
    return min(max(d.x, d.y), 0.0f) + length(max2(d, 0.0f));
}

// Capped Cylinder (arbitrary) - exact
float sdCappedCylinder2(float3 p, float3 a, float3 b, float r) {
    float3 ba = b - a;
    float3 pa = p - a;
    float baba = dot(ba, ba);
    float paba = dot(pa, ba);
    float x = length(pa * baba - ba * paba) - r * baba;
    float y = fabs(paba - baba * 0.5f) - baba * 0.5f;
    float x2 = x * x;
    float y2 = y * y * baba;
    float d = (max(x, y) < 0.0f) ? -min(x2, y2) : ((x > 0.0f ? x2 : 0.0f) + (y > 0.0f ? y2 : 0.0f));
    return sign(d) * sqrt(fabs(d)) / baba;
}

// Rounded Cylinder - exact
float sdRoundedCylinder(float3 p, float ra, float rb, float h) {
    float2 d = float2(length(float2(p.x, p.z)) - 2.0f * ra + rb, fabs(p.y) - h);
    return min(max(d.x, d.y), 0.0f) + length(max2(d, 0.0f)) - rb;
}

// Capped Cone - exact
float sdCappedCone(float3 p, float h, float r1, float r2) {
    float2 q = float2(length(float2(p.x, p.z)), p.y);
    float2 k1 = float2(r2, h);
    float2 k2 = float2(r2 - r1, 2.0f * h);
    float2 ca = float2(q.x - min(q.x, (q.y < 0.0f) ? r1 : r2), fabs(q.y) - h);
    float2 cb = q - k1 + k2 * clamp(dot(k1 - q, k2) / dot22(k2), 0.0f, 1.0f);
    float s = (cb.x < 0.0f && ca.y < 0.0f) ? -1.0f : 1.0f;
    return s * sqrt(min(dot22(ca), dot22(cb)));
}

// Capped Cone (arbitrary) - exact
float sdCappedCone2(float3 p, float3 a, float3 b, float ra, float rb) {
    float rba = rb - ra;
    float baba = dot(b - a, b - a);
    float papa = dot(p - a, p - a);
    float paba = dot(p - a, b - a) / baba;
    float x = sqrt(papa - paba * paba * baba);
    float cax = max(0.0f, x - ((paba < 0.5f) ? ra : rb));
    float cay = fabs(paba - 0.5f) - 0.5f;
    float k = rba * rba + baba;
    float f = clamp((rba * (x - ra) + paba * baba) / k, 0.0f, 1.0f);
    float cbx = x - ra - f * rba;
    float cby = paba - f;
    float s = (cbx < 0.0f && cay < 0.0f) ? -1.0f : 1.0f;
    return s * sqrt(min(cax * cax + cay * cay * baba,
                        cbx * cbx + cby * cby * baba));
}

// Solid Angle - exact
float sdSolidAngle(float3 p, float2 c, float ra) {
    // c is the sin/cos of the angle
    float2 q = float2(length(float2(p.x, p.z)), p.y);
    float l = length(q) - ra;
    float m = length(q - c * clamp(dot(q, c), 0.0f, ra));
    return max(l, m * sign(c.y * q.x - c.x * q.y));
}

// Round Cone - exact
float sdRoundCone(float3 p, float r1, float r2, float h) {
    float2 q = float2(length(float2(p.x, p.z)), p.y);
    float b = (r1 - r2) / h;
    float a = sqrt(1.0f - b * b);
    float k = dot(q, float2(-b, a));
    if (k < 0.0f) return length(q) - r1;
    if (k > a * h) return length(q - float2(0.0f, h)) - r2;
    return dot(q, float2(a, b)) - r1;
}

// Round Cone (arbitrary) - exact
float sdRoundCone2(float3 p, float3 a, float3 b, float r1, float r2) {
    float3 ba = b - a;
    float l2 = dot(ba, ba);
    float rr = r1 - r2;
    float a2 = l2 - rr * rr;
    float il2 = 1.0f / l2;
    float3 pa = p - a;
    float y = dot(pa, ba);
    float z = y - l2;
    float x2 = dot23(pa * l2 - ba * y);
    float y2 = y * y * l2;
    float z2 = z * z * l2;
    float k = sign(rr) * rr * rr * x2;
    if (sign(z) * a2 * z2 > k) return sqrt(x2 + z2) * il2 - r2;
    if (sign(y) * a2 * y2 < k) return sqrt(x2 + y2) * il2 - r1;
    return (sqrt(x2 * a2 * il2) + y * rr) * il2 - r1;
}

// Ellipsoid - bound (not exact!)
float sdEllipsoid(float3 p, float3 r) {
    float k0 = length(p / r);
    float k1 = length(p / (r * r));
    return k0 * (k0 - 1.0f) / k1;
}

// Rhombus - exact
float sdRhombus(float3 p, float la, float lb, float h, float ra) {
    p = fabs3(p);
    float2 b = float2(la, lb);
    float2 pxz = float2(p.x, p.z);
    float f = clamp(ndot(b, b - 2.0f * pxz) / dot(b, b), -1.0f, 1.0f);
    float2 q = float2(
        length(pxz - 0.5f * b * float2(1.0f - f, 1.0f + f)) * sign(p.x * b.y + p.z * b.x - b.x * b.y) - ra,
        p.y - h);
    return min(max(q.x, q.y), 0.0f) + length(max2(q, 0.0f));
}

// Octahedron - exact
float sdOctahedron(float3 p, float s) {
    p = fabs3(p);
    float m = p.x + p.y + p.z - s;
    float3 q;
    if (3.0f * p.x < m) q = float3(p.x, p.y, p.z);
    else if (3.0f * p.y < m) q = float3(p.y, p.z, p.x);
    else if (3.0f * p.z < m) q = float3(p.z, p.x, p.y);
    else return m * 0.57735027f;
    float k = clamp(0.5f * (q.z - q.y + s), 0.0f, s);
    return length(float3(q.x, q.y - s + k, q.z - k));
}

// Octahedron - bound (not exact)
float sdOctahedronB(float3 p, float s) {
    p = fabs3(p);
    return (p.x + p.y + p.z - s) * 0.57735027f;
}

// Pyramid - exact
float sdPyramid(float3 p, float h) {
    float m2 = h * h + 0.25f;
    p.x = fabs(p.x);
    p.z = fabs(p.z);
    if (p.z > p.x) {
        float tmp = p.x;
        p.x = p.z;
        p.z = tmp;
    }
    p.x -= 0.5f;
    p.z -= 0.5f;
    float3 q = float3(p.z, h * p.y - 0.5f * p.x, h * p.x + 0.5f * p.y);
    float s = max(-q.x, 0.0f);
    float t = clamp((q.y - 0.5f * p.z) / (m2 + 0.25f), 0.0f, 1.0f);
    float a = m2 * (q.x + s) * (q.x + s) + q.y * q.y;
    float b = m2 * (q.x + 0.5f * t) * (q.x + 0.5f * t) + (q.y - m2 * t) * (q.y - m2 * t);
    float d2 = min(q.y, -q.x * m2 - q.y * 0.5f) > 0.0f ? 0.0f : min(a, b);
    return sqrt((d2 + q.z * q.z) / m2) * sign(max(q.z, -p.y));
}

// Triangle - exact
float sdTriangle3D(float3 p, float3 a, float3 b, float3 c) {
    float3 ba = b - a; float3 pa = p - a;
    float3 cb = c - b; float3 pb = p - b;
    float3 ac = a - c; float3 pc = p - c;
    float3 nor = cross(ba, ac);
    return sqrt(
        (sign(dot(cross(ba, nor), pa)) +
         sign(dot(cross(cb, nor), pb)) +
         sign(dot(cross(ac, nor), pc)) < 2.0f)
        ?
        min(min(
            dot23(ba * clamp(dot(ba, pa) / dot23(ba), 0.0f, 1.0f) - pa),
            dot23(cb * clamp(dot(cb, pb) / dot23(cb), 0.0f, 1.0f) - pb)),
            dot23(ac * clamp(dot(ac, pc) / dot23(ac), 0.0f, 1.0f) - pc))
        :
        dot(nor, pa) * dot(nor, pa) / dot23(nor));
}

// Quad - exact
float sdQuad3D(float3 p, float3 a, float3 b, float3 c, float3 d) {
    float3 ba = b - a; float3 pa = p - a;
    float3 cb = c - b; float3 pb = p - b;
    float3 dc = d - c; float3 pc = p - c;
    float3 ad = a - d; float3 pd = p - d;
    float3 nor = cross(ba, ad);
    return sqrt(
        (sign(dot(cross(ba, nor), pa)) +
         sign(dot(cross(cb, nor), pb)) +
         sign(dot(cross(dc, nor), pc)) +
         sign(dot(cross(ad, nor), pd)) < 3.0f)
        ?
        min(min(min(
            dot23(ba * clamp(dot(ba, pa) / dot23(ba), 0.0f, 1.0f) - pa),
            dot23(cb * clamp(dot(cb, pb) / dot23(cb), 0.0f, 1.0f) - pb)),
            dot23(dc * clamp(dot(dc, pc) / dot23(dc), 0.0f, 1.0f) - pc)),
            dot23(ad * clamp(dot(ad, pd) / dot23(ad), 0.0f, 1.0f) - pd))
        :
        dot(nor, pa) * dot(nor, pa) / dot23(nor));
}
