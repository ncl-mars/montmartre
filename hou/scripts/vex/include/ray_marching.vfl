#ifndef RAY_MARCHING

    #if defined(_MAP)!=1
        float defaultMap(vector pos)
        {
            return length(pos)-0.5;
        }
        #define _MAP defaultMap
    #endif

    vector calcNormal( vector pos; float eps){

        vector2 e = set(1.0,-1.0)*0.5773*eps;
        return normalize(   set(e.x,e.y,e.y)*_MAP( pos + set(e.x,e.y,e.y) ) + 
                            set(e.y,e.y,e.x)*_MAP( pos + set(e.y,e.y,e.x) ) + 
                            set(e.y,e.x,e.y)*_MAP( pos + set(e.y,e.x,e.y) ) + 
                            set(e.x,e.x,e.x)*_MAP( pos + set(e.x,e.x,e.x) ) );
    }


