/*
    * 3D - SDF

*/
#include "$HOME/libs/vex/include/sd_shapes_3d.vfl"
#include "$HOME/libs/vex/include/sd_operations.vfl"


float map(vector pos){
    // return sdRoundCone(pos, 0.4  , 0.2 , 0.5 );
    return sdTorus(pos, {0.5,0.25});
}


#define _MAP map
#include "$HOME/libs/vex/include/ray_marching.vfl"


cvex sd_shapes_3d(
    export vector P = {0,0,0};
    export float density = 0;
    export vector col = 0;
    )
{
    vector dim = chv("../sd_density_volume/size");
    float scl = min(dim.x, dim.y);
    scl*=0.5;

    vector pos = P/scl;
    float d = 1e6;

    d = map(pos);
    density = -d * 1.5 ;
    col = calcNormal(pos,0.05);
}


