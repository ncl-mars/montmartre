//______________________________________________________________________


#include "$HIP/scripts/vex/include/remapping.vfl"

int isdiamond = i@group_diamond; 


int iid = i@iid;
float did = ((25 - iid) + 0)%26;

float time = @Time;
float an;
float t0, t1;

float scltime = 0.5;
time *= scltime;

time += 0.45;
time -= did * 0.2; // delai per index

if(time < 0)
{
    removepoint(0, @ptnum,1); // rm pts
} 


matrix xform = 4@transform;
vector ori = @P; // end pos
vector pos = ptransform(ori,invert(xform));

//-- transform
float rotdur = 0.6;
float rotdel = 0.5;
float nturns = 1.0;
float trsdur = 1.0;
float trsdst = 1.0;
float mskdur = 0.35;

// rot
if(isdiamond){
    an = fit(time-rotdel,0,rotdur,0,1);
    an = pow(an, 0.5);
    // pos = qrotate(eulertoquaternion(set(an*nturns*M_PI*-2,0,0),0),pos);


    // trans
    an = fit(time,0,trsdur,0,1);
    an = primuv(1, "y", 0, an);
    
    pos.x += max(1.0-an,0)*trsdst;
}
else{
    // trans
    time -= trsdur-0.;
    an = fit(time,0,mskdur,0,1);
    // an = gain(an,2.0);
    pos.x += max(an,0)*0.025;

    if(time > mskdur) removepoint(0, @ptnum,1);


}


// apply mat
pos = ptransform(pos,xform); 

@P = pos;
// @Cd = did / 13.0;

@Cd = did/26.0;
@Cd = 0.5;
